<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="776.0" prefWidth="695.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.upeu.tiendderopa.controller.GestionProductoController">
   <children>
      <Label layoutX="121.0" layoutY="14.0" text="GESTIONAR PRODUCTOS - TIENDA DE ROPA" textFill="#2c3e50">
         <font>
            <Font name="Berlin Sans FB" size="22.0" />
         </font>
      </Label>
      <GridPane layoutX="55.0" layoutY="49.0" prefHeight="288.0" prefWidth="525.0">
        <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Label text="Tipo Producto" />
            <Label text="Nombre del Producto" GridPane.rowIndex="1" />
            <Label text="Precio (S/):" GridPane.rowIndex="2" />
            <Label text="Stock." GridPane.rowIndex="3" />
            <Label text="Categoria:" GridPane.rowIndex="4" />
            <Label text="Marca:" GridPane.rowIndex="5" />
            <Label text="Talla:" GridPane.rowIndex="6" />
            <Label text="Unidad de Medida:" GridPane.rowIndex="7" />
            <TextField fx:id="txtTipoProducto" GridPane.columnIndex="1" />
            <TextField fx:id="txtNombreProducto" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <TextField fx:id="txtPrecio" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <TextField fx:id="txtStock" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <TextField fx:id="txtCategoria" GridPane.columnIndex="1" GridPane.rowIndex="4" />
            <TextField fx:id="txtMarca" GridPane.columnIndex="1" GridPane.rowIndex="5" />
            <TextField fx:id="txtUnidadMedida" GridPane.columnIndex="1" GridPane.rowIndex="7" />
            <ComboBox fx:id="cbxTalla" prefHeight="25.0" prefWidth="276.0" GridPane.columnIndex="1" GridPane.rowIndex="6" />
         </children>
      </GridPane>
      <HBox layoutX="434.0" layoutY="345.0" prefHeight="32.0" prefWidth="146.0" spacing="20.0">
         <children>
            <Button mnemonicParsing="false" onAction="#cancelar" text="Cancelar" />
            <Button mnemonicParsing="false" onAction="#guardarProducto" text="Guardar" />
         </children>
      </HBox>
      <HBox layoutX="42.0" layoutY="385.0" prefHeight="42.0" prefWidth="348.0" spacing="10.0">
         <children>
            <Label text="Buscar Por Nombre" />
            <TextField fx:id="txtBuscar" />
            <Button mnemonicParsing="false" onAction="#buscarProducto" text="Buscar" />
         </children>
      </HBox>
      <TableView fx:id="tablaProductos" layoutX="16.0" layoutY="427.0" prefHeight="200.0" prefWidth="602.0">
        <columns>
          <TableColumn fx:id="colTipo" prefWidth="75.0" text="Tipo" />
          <TableColumn fx:id="colNombre" prefWidth="75.0" text="Nombre" />
            <TableColumn fx:id="colPrecio" prefWidth="75.0" text="Precio" />
            <TableColumn fx:id="colStock" prefWidth="75.0" text="Stock" />
            <TableColumn fx:id="colCategoria" prefWidth="75.0" text="Categoria" />
            <TableColumn fx:id="colTalla" prefWidth="75.0" text="Talla" />
            <TableColumn fx:id="colMarca" prefWidth="75.0" text="Marca" />
            <TableColumn fx:id="colUnidad" prefWidth="75.0" text="Unidad" />
        </columns>
      </TableView>
   </children>
</AnchorPane>
